# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix are server-only and never reach the browser.

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Supabase dashboard → Connect → ORMs → Prisma.
# Runtime: transaction pooler (port 6543). Required on Vercel serverless.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / seed: direct or session connection (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth.js ────────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# ── Supabase Realtime (live ticket updates) ────────────────────────────────────
# Public by design: only used to LISTEN on broadcast channels. Tables are locked by deny-all RLS.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only: used to SEND broadcast events.
SUPABASE_SERVICE_ROLE_KEY=""
# Server-only: random string naming the admin broadcast channel (e.g. `openssl rand -hex 16`).
ADMIN_REALTIME_KEY=""

# ── AI (Google Gemini) — server-only ───────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Set to "true" to simulate an AI outage and demo graceful degradation.
AI_FORCE_FAIL="false"

# ── Misc ───────────────────────────────────────────────────────────────────────
# Optional fixed "today" (YYYY-MM-DD) for royalty payout-date maths. Defaults to the real date.
APP_TODAY=""
