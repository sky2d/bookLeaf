    "db:verify": "tsx scripts/verifyDb.ts",
    "smoke:rbac": "tsx scripts/smokeRbac.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
